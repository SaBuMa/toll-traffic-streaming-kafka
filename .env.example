# Copy to .env, fill in your values, then load it before running the consumer:
#   cp .env.example .env
#   set -a; source .env; set +a
# .env is git-ignored: real credentials never reach GitHub.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=toll
KAFKA_GROUP_ID=toll-mysql-loader

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tolldata
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
